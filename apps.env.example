# Local environment for the testing-lifecycle pipeline.
# Copy this file to `apps.env` and fill in the values you need:
#
#     cp apps.env.example apps.env
#
# `apps.env` is gitignored. The /run-* skills source it before each run,
# so anything you set here is picked up automatically.
#
# Keys mirror .github/workflows/testing-lifecycle.yml — set the same names
# locally that CI sets in the workflow env block.

# ── Required for the agent pipeline ───────────────────────────────────────────

# Anthropic Claude API key (Stages 1, 2, 3, 4, 5).
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Service URLs (defaults match docker-compose.yml) ──────────────────────────

API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
JIRA_BASE_URL=http://localhost:8080

# ── Optional ──────────────────────────────────────────────────────────────────

# harqis-core config YAML — only needed if you run the test-agents skill
# or other code paths that load config via ConfigLoaderService.
# ENV_APP_CONFIG_FILE=./sample_config.yaml

# Anthropic Admin key — only needed by the MCP usage/cost tools in mcp/.
# Falls back to ANTHROPIC_API_KEY if unset.
# ANTHROPIC_ADMIN_KEY=
